# Copy to .env and fill in. Never commit .env.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI on your Intuit app (Keys & credentials).
# The OAuth Playground address works without running a web server:
QBO_REDIRECT_URI=https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl
# sandbox or production
QBO_ENVIRONMENT=sandbox
