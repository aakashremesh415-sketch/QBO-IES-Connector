# Neon (or any Postgres) connection string. On Vercel, add the Neon integration and it sets this for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Sign-in sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's public address, e.g. https://ies-connector.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Encrypts QuickBooks sign-in tokens stored in the database. 32+ random characters.
# Changing it later means every company must be connected again.
TOKEN_ENCRYPTION_KEY=

# Intuit app keys (developer.intuit.com -> your app -> Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox or production
QBO_ENVIRONMENT=sandbox
# Optional. Defaults to <NEXTAUTH_URL>/api/qbo/callback, which must be listed as a Redirect URI on the Intuit app.
# QBO_REDIRECT_URI=

# Optional: true = the person who confirms a change must be different from the person who prepared it.
REQUIRE_SECOND_APPROVER=false
